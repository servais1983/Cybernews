# Copiez ce fichier vers .env puis remplissez vos valeurs.
# Pour Gmail, créez un "mot de passe d'application" : https://myaccount.google.com/apppasswords

SENDER_EMAIL=votre_email@gmail.com
EMAIL_PASSWORD=votre_mot_de_passe_application
RECIPIENT_EMAIL=destinataire@example.com
SMTP_SERVER=smtp.gmail.com
# 465 = SSL implicite, 587 = STARTTLS (les deux sont supportés)
SMTP_PORT=465

# Optionnel
EMAIL_SUBJECT_PREFIX=🛡️ CyberNews —
# Fenêtre de récupération par défaut, en jours
DAYS_LOOKBACK=2
