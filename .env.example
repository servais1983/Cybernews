# Copiez ce fichier vers .env puis remplissez vos valeurs.
# Seule la section Email est obligatoire ; tout le reste est optionnel.

# --- Email (obligatoire pour l'envoi) ---------------------------------------
# Pour Gmail, créez un "mot de passe d'application" :
# https://myaccount.google.com/apppasswords
SENDER_EMAIL=votre_email@gmail.com
EMAIL_PASSWORD=votre_mot_de_passe_application
RECIPIENT_EMAIL=destinataire@example.com
SMTP_SERVER=smtp.gmail.com
# 465 = SSL implicite, 587 = STARTTLS (les deux sont supportés)
SMTP_PORT=465
EMAIL_SUBJECT_PREFIX=🛡️ CyberNews —

# --- Comportement ------------------------------------------------------------
# Fenêtre de récupération par défaut, en jours
DAYS_LOOKBACK=2
# Filtres par mots-clés (séparés par des virgules, insensibles à la casse).
# KEYWORDS_INCLUDE : ne garder QUE les articles contenant un de ces mots.
# KEYWORDS_EXCLUDE : écarter les articles contenant un de ces mots.
#KEYWORDS_INCLUDE=vmware,cisco,active directory
#KEYWORDS_EXCLUDE=webinar,sponsored

# --- Synthèse IA (optionnel) ---------------------------------------------------
# Si définie, génère un brief exécutif et des résumés en français via l'API
# Claude : https://platform.claude.com/
#ANTHROPIC_API_KEY=sk-ant-...
#CLAUDE_MODEL=claude-opus-4-8

# --- Enrichissement CVE (optionnel) -------------------------------------------
# Clé gratuite NVD (accélère les requêtes CVSS) :
# https://nvd.nist.gov/developers/request-an-api-key
#NVD_API_KEY=...

# --- Canaux supplémentaires (optionnels) ---------------------------------------
#DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
#TELEGRAM_BOT_TOKEN=123456:ABC...
#TELEGRAM_CHAT_ID=-1001234567890

# --- Publication GitHub Pages (optionnel) --------------------------------------
# URL publique du digest (utilisée dans le flux RSS sortant et les webhooks)
#SITE_URL=https://votre_compte.github.io/Cybernews
